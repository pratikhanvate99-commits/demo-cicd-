{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot-CicdLiveDemoApplication",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "com.pratik.demo.CicdLiveDemoApplication",
      "projectName": "cicd-live-demo",
      "args": "--server.port=8081"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Live Demo in Chrome",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
